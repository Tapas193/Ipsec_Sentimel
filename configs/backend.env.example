# Backend-only environment overrides.
# Copy to `.env` or pass with `set -a; source configs/backend.env.example; set +a`.
# Together with the root `.env.example` these document every switch the app reads.

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Leave blank to fall back to SQLite for local development.
DATABASE_URL=postgresql+psycopg://ipsec_sentinel:ipsec_sentinel_dev_password@localhost:5432/ipsec_sentinel

# --- Frontend CORS -----------------------------------------------------------
CORS_ORIGINS=http://localhost:2456,http://localhost:8080

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=500

# --- Security (disables auth until later phases) -----------------------------
AUTH_ENABLED=false
JWT_SECRET=change-this-in-production