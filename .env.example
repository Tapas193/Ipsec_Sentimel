# ---------------------------------------------------------------------------
# IPsec Sentinel — environment variables (example only).
# Copy to `.env` and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# Application
APP_NAME=IPsec Sentinel
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database (backend). PostgreSQL is the primary target.
# SQLite is used automatically for local/test work when this is left blank.
DATABASE_URL=postgresql+psycopg://ipsec_sentinel:ipsec_sentinel_dev_password@localhost:5432/ipsec_sentinel

# Frontend → backend connectivity
# VITE_API_BASE_URL is inlined by Vite at build/dev time.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Used by the Vite dev-server proxy when no VITE_API_BASE_URL is set.
VITE_API_PROXY_TARGET=http://localhost:8000

# Backend CORS — comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:2456,http://localhost:8080

# Uploads (backend storage directory)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=500

# --- Machine learning (Phase 4) --------------------------------------------
# ML_ENABLED gates inference only. With it off, the Traffic Intelligence UI
# still loads but every analysis reports MODEL_NOT_AVAILABLE.
ML_ENABLED=false
# Training stays off unless an operator deliberately enables it. Labels are
# only ever read from ML_LABEL_FILE, never inferred from an uploaded capture.
ML_TRAINING_ENABLED=false
ML_MODEL_DIR=./data/models
# Minimum predicted probability to report a class. Below it the prediction is
# UNKNOWN with observation_status=MODEL_PREDICTED (abstention, not a guess).
ML_MIN_CONFIDENCE=0.60
ML_RANDOM_SEED=42
ML_DATASET_VERSION=1.0
# Empty = newest compatible model. Set to pin one, e.g. traffic-classifier-0.1.0
ML_DEFAULT_MODEL_VERSION=
# Operator-supplied ground-truth file (YAML/JSON). Empty means no labeled data
# exists and training reports INSUFFICIENT_LABELED_DATA.
ML_LABEL_FILE=

# --- Docker Compose only ----------------------------------------------------
POSTGRES_USER=ipsec_sentinel
POSTGRES_PASSWORD=ipsec_sentinel_dev_password
POSTGRES_DB=ipsec_sentinel
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Optional: force an explicit container platform (defaults to the host arch).
# On Apple Silicon M-series this is linux/arm64 automatically.
#DOCKER_PLATFORM=linux/arm64